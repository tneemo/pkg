{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "pkg-registry",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"routes": [
		{
			"pattern": "pkg.tneemo.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pkg",
			// From `npx wrangler d1 create pkg`.
			"database_id": "04d5e992-b07e-4fd2-b3af-35915eb1fa0a",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUNDLES",
			"bucket_name": "pkg-bundles"
		}
	],
	"observability": {
		"enabled": true
	}
}
