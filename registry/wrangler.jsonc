{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pkg-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "pkg.tneemo.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pkg",
      // Replace with the id printed by `npx wrangler d1 create pkg` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "pkg-bundles" }],
  "observability": { "enabled": true }
}
